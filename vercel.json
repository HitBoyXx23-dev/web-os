{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/wisp.js": { "maxDuration": 300 },
    "api/party.js": { "maxDuration": 300 },
    "api/generate.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/wisp/", "destination": "/api/wisp" },
    { "source": "/api/party/:app/:room/:name", "destination": "/api/party?app=:app&room=:room&name=:name" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/vm/ubuntu24/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" }
      ]
    }
  ]
}
